{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  // Linter fixtures are sample PLUGIN source (JSX, decky imports). They exist
  // to be parsed by the linter, never compiled by this server.
  "exclude": ["src/lint/__fixtures__"]
}

{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/decky-claude-hook.mjs --match \"src/**/*.{ts,tsx},main.py,plugin.json\" --message \"Decky: run plugin_build (MCP) after Deck-facing edits; preview: node scripts/run-preview-suite.mjs --tier=smoke\""
          },
          {
            "type": "command",
            "command": "node scripts/decky-claude-hook.mjs --match \"src/**/*.{ts,tsx},main.py\" --run scripts/decky-rpc-drift-hint.mjs"
          },
          {
            "type": "command",
            "command": "node scripts/decky-claude-hook.mjs --match \"src/components/**/*.{ts,tsx},src/utils/build*Element.tsx\" --run scripts/decky-focus-gate-hint.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/decky-claude-hook.mjs --match \"src/**/*.{ts,tsx},main.py,plugin.json\" --run scripts/decky-handoff-check.mjs --git"
          }
        ]
      }
    ]
  }
}
